{
  "expo": {
    "name": "SevaASHA",
    "slug": "SevaASHA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.jpeg",
    "scheme": "sevaasha",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/105b94ed-429d-41dc-84d3-f4e77d6ba868"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to send emergency alerts to supervisors.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.gangothri.sevaasha"
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./logo.jpeg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gangothri.sevaasha"
    },
    "web": {
      "output": "static",
      "favicon": "./logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./logo.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "105b94ed-429d-41dc-84d3-f4e77d6ba868"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
